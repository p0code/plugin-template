{
  "name": "@p0code/plugin-template",
  "version": "0.1.0",
  "description": "A starting point for p0code plugins",
  "private": false,
  "license": "MIT",
  "repository": "https://github.com/p0code/plugin-template",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./actions": {
      "types": "./src/actions.ts",
      "import": "./src/actions.ts"
    }
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir ."
  },
  "dependencies": {
    "@t3tools/contracts": "workspace:*",
    "@t3tools/plugin-api": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
